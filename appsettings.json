{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Oss": {
    "StorageRoot": "./oss-storage",
    "Regions": [
      "cn-east-1",
      "us-west-1"
    ],
    "MaxQuotaPerRegion": {
      "cn-east-1": "10GB",
      "us-west-1": "5GB"
    },
    "MaxFileSizeBytes": 10485760
  },
  "AccessKeys": [
    {
      "KeyId": "oss-key-001",
      "SecretKey": "secret-xxx",
      "EnabledRegions": [ "*" ]
    }
  ]
}
